          {
            "phase_number": 3,
            "name": "Synthesis & Peer Review",
            "description": "Perform statistical hypothesis testing, synthesize findings, and draft formal scientific report.",
            "estimated_duration": "1-2 weeks",
            "deliverables": ["Peer-Review Ready Paper", "Reproducibility Artifacts"]
          }
        ],
        "explain": [
          {
            "phase_number": 1,
            "name": "Core Scientific Principles",
            "description": "Introduce fundamental laws, underlying physics/chemistry/biology concepts, and historical context.",
            "estimated_duration": "Step 1",
            "deliverables": ["Theoretical Foundation Brief"]
          },
          {
            "phase_number": 2,
            "name": "Mechanistic Deep Dive",
            "description": "Detail molecular, mathematical, or physical mechanisms with empirical proof points.",
            "estimated_duration": "Step 2",
            "deliverables": ["Mechanistic Breakdown"]
          },
          {
            "phase_number": 3,
            "name": "Modern Applications & Frontiers",
            "description": "Connect theory to modern research frontiers, experimental instruments, and real-world impact.",
            "estimated_duration": "Step 3",
            "deliverables": ["State of the Art Summary"]
          }
        ]
      }
