{
  "domain_taxonomy": [
    {
      "domain": "computers",
      "aliases": ["computer-science", "computing", "it", "systems-architecture"],
      "boost": 3,
      "keywords": [
        "computer", "computing", "cpu", "gpu", "processor", "memory", "ram", "storage", "ssd", "nvme",
        "operating-system", "kernel", "linux", "unix", "windows", "network", "tcp-ip", "dns", "lan", "wan",
        "distributed-systems", "concurrency", "threading", "compiler", "runtime", "virtual-machine", "hypervisor",
        "cache", "bus", "firmware", "assembly", "instruction-set", "risc", "cisc", "cloud-computing", "server"
      ],
      "persona_template": "Principal {role} specializing in computer systems architecture, low-level optimization, runtime performance, and scalable infrastructure.",
      "phase_templates": {
        "build": [
          {
            "phase_number": 1,
            "name": "System Architecture & Specs",
            "description": "Define hardware/software compute requirements, throughput constraints, and interface specifications.",
            "estimated_duration": "3-5 days",
            "deliverables": ["System Architecture Specification", "Compute & Memory Budget"]
          },
          {
            "phase_number": 2,
            "name": "Core System Implementation",
            "description": "Develop core modules, memory management, concurrency models, and driver/OS integrations.",
            "estimated_duration": "1-3 weeks",
            "deliverables": ["Working System Implementation", "Benchmark Test Suite"]
          },
          {
            "phase_number": 3,
            "name": "Optimization & Deployment",
            "description": "Profile bottlenecks, optimize cache/memory locality, and configure production telemetry.",
            "estimated_duration": "3-5 days",
            "deliverables": ["Performance Audit Report", "Production Configuration"]
          }
        ],
        "analyze": [
          {
            "phase_number": 1,
            "name": "Profiling & Telemetry Gathering",
            "description": "Collect hardware counters, trace system calls, and benchmark latency/throughput profiles.",
            "estimated_duration": "1-2 days",
            "deliverables": ["Telemetry Profile Dataset", "Resource Utilization Baseline"]
          },
          {
            "phase_number": 2,
            "name": "Bottleneck & Root Cause Analysis",
            "description": "Analyze thread contention, cache misses, IO saturation, and algorithmic complexity.",
            "estimated_duration": "2-3 days",
            "deliverables": ["Bottleneck Diagnosis Matrix", "Optimization Opportunity Log"]
          },
          {
            "phase_number": 3,
            "name": "Optimization Roadmap",
            "description": "Formulate prioritized architectural and configuration recommendations.",
            "estimated_duration": "1-2 days",
            "deliverables": ["Target Architecture Recommendations", "Implementation Roadmap"]
          }
        ]
      }
    },
