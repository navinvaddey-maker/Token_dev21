# ============================================================================
# token_compress_engine — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# Database connection URL
# SQLite:    sqlite:./token_compress.db?mode=rwc
# Postgres:  postgres://user:pass@localhost:5432/token_optimizer
DATABASE_URL=sqlite:./token_compress.db?mode=rwc

# JWT secret for token signing — MUST be changed in production
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=change_me_to_a_secure_random_string

# Admin user password — used for initial admin user seeding
# If not set, a random fallback is generated (logged at startup)
ADMIN_PASSWORD=your_secure_admin_password

# Rust logging configuration
# Levels: error, warn, info, debug, trace
RUST_LOG=token_compress_engine=info,sqlx=warn
